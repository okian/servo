
# Binaries for programs and plugins. The named entries are the tutorial's
# three injectors: `go build ./cmd/orders` in that module drops a 40MB
# executable beside the source, and it is easy to miss in a diff.
/examples/tutorial/orders
/examples/tutorial/ordersgin
/examples/tutorial/ordersgrpc
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/

# IDEs
.idea/
.vscode/

