#!/bin/sh
# Reference pre-commit hook: fails the commit if any injector's committed
# generated file doesn't match what `servo generate` would produce from the
# code being committed, catching drift (a constructor signature changed,
# generate wasn't re-run) before it lands instead of in review or CI.
#
# Install by pointing git at this directory instead of copying the file:
#   git config core.hooksPath githooks
# (this hook then applies to every clone that runs that command; it is
# not enabled automatically just by being present in the repository).

set -e

if ! command -v go >/dev/null 2>&1; then
	echo "pre-commit: go not found on PATH, skipping servo check" >&2
	exit 0
fi

# The check has to see what is being committed, not the working tree. With
# part of a change staged (`git add -p`), the working tree can be
# consistent while the commit is not: a constructor change staged without
# its regenerated servo_gen.go used to pass this hook, and then failed
# check and build in CI. So whatever is not staged — edits and untracked
# files alike — is stashed for the check and put back afterwards, however
# the hook exits. Nothing is stashed when there is nothing to set aside,
# nor before the first commit or while a merge is being concluded, when
# git cannot stash; then the working tree is what gets checked.
stashed=
restore() {
	status=$?
	trap - EXIT
	if [ -n "$stashed" ]; then
		# The working tree goes back exactly as it was: tracked files from
		# the stash's working-tree commit, untracked ones from its third
		# parent. Not `git stash pop`, which merges, and a merge cannot tell
		# an unstaged edit that undoes a staged one from no edit at all: it
		# would leave the staged version in the working tree. The stash is
		# dropped only if it is still on top, never someone else's.
		if git restore --source="$stashed" --worktree -- . &&
			{ ! git rev-parse -q --verify "$stashed^3" >/dev/null ||
				git restore --overlay --source="$stashed^3" --worktree -- .; }; then
			if [ "$(git rev-parse -q --verify refs/stash)" = "$stashed" ]; then
				git stash drop --quiet
			fi
		else
			echo "pre-commit: could not put your unstaged changes back; they are kept in the stash as $stashed (git stash list)" >&2
			status=1
		fi
	fi
	exit "$status"
}
trap restore EXIT
trap 'exit 1' HUP INT TERM

if git rev-parse -q --verify HEAD >/dev/null &&
	! git rev-parse -q --verify MERGE_HEAD >/dev/null &&
	{ ! git diff --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; }; then
	before=$(git rev-parse -q --verify refs/stash || true)
	git stash push --quiet --keep-index --include-untracked --message "servo pre-commit hook: unstaged changes"
	after=$(git rev-parse -q --verify refs/stash || true)
	if [ "$after" != "$before" ]; then
		stashed=$after
	fi
fi

# Inside servo's own repository the injectors live in the example modules
# and the generator is ./cmd/servo, so the hook runs the same checks CI
# does. Everywhere else it is the one line a consumer module needs.
if [ -f cmd/servo/main.go ] && grep -q '^module github.com/okian/servo/v3$' go.mod 2>/dev/null; then
	echo "pre-commit: servo check (every example module)"
	for dir in examples/basic examples/scoped examples/mocking examples/http examples/tutorial examples/variants; do
		go run ./cmd/servo check --dir "$dir"
	done
	go run ./cmd/servo check --dir examples/variants --tags=prod
	exit 0
fi

# A project with build variants needs one check per configuration, since
# each variant has its own generated file and `check` only inspects the one
# its flags select:
#   go tool servo check --tags=prod
#
# `go tool`, not `go run <the generator's package>`: a consumer requires
# servo for the marker package alone, so the generator's own dependencies
# are not in their build list and `go run` fails on a missing go.sum entry.
# The tool directive also pins the version, so this hook and CI cannot
# disagree about what the generated file should contain. Add it once with:
#   go get -tool github.com/okian/servo/v3/cmd/servo
echo "pre-commit: servo check"
go tool servo check
