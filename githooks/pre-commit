#!/bin/sh
# Reference pre-commit hook: fails the commit if any injector's committed
# generated file doesn't match what `servo generate` would produce right
# now, catching drift (a constructor signature changed, generate wasn't
# re-run) before it lands instead of in review or CI.
#
# Install by pointing git at this directory instead of copying the file:
#   git config core.hooksPath githooks
# (this hook then applies to every clone that runs that command; it is
# not enabled automatically just by being present in the repository).

set -e

if ! command -v go >/dev/null 2>&1; then
	echo "pre-commit: go not found on PATH, skipping servo check" >&2
	exit 0
fi

# A project with build variants needs one check per configuration, since
# each variant has its own generated file and `check` only inspects the one
# its flags select:
#   go tool servo check --tags=prod
#
# `go tool`, not `go run <the generator's package>`: a consumer requires
# servo for the marker package alone, so the generator's own dependencies
# are not in their build list and `go run` fails on a missing go.sum entry.
# The tool directive also pins the version, so this hook and CI cannot
# disagree about what the generated file should contain. Add it once with:
#   go get -tool github.com/okian/servo/v3/cmd/servo
echo "pre-commit: servo check"
go tool servo check
