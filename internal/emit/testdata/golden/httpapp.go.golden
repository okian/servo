		servoimpl.Call{Node: "http:telemetry", Fn: a.httpTelemetryServer.run},
	)
}

func (a *App) Shutdown(ctx context.Context) servo.Report {
	forceExit := make(chan os.Signal, 1)
	signal.Notify(forceExit, os.Interrupt, syscall.SIGTERM)
	defer signal.Stop(forceExit)
	watcherDone := make(chan struct{})
	defer close(watcherDone)
	go func() {
		select {
		case sig := <-forceExit:
			servoimpl.ForceExit(sig)
		case <-watcherDone:
		}
	}()

	var nodes []servo.NodeResult
	nodes = append(nodes, a.stopHttpServer(ctx))
	nodes = append(nodes, a.stopHttpTelemetryServer(ctx))
	nodes = append(nodes, a.stopRepo(ctx))
	return servo.Report{Nodes: nodes}
}

// HTTPHandler returns the named group's routed, middleware-wrapped handler
// — for httptest, which needs no bound listener. "" and "default" name the
// default group; unknown names return nil.
func (a *App) HTTPHandler(group string) http.Handler {
	switch group {
	case "", "default":
		return a.httpServer.srv.Handler
	case "telemetry":
		return a.httpTelemetryServer.srv.Handler
	}
	return nil
}

