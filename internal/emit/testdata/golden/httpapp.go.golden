		var h http.Handler = http.HandlerFunc(s.handleOrder)
		h = a.audit.Middleware(h)
		mux.Handle("POST /order/{category}/", h)
	}
	var handler http.Handler = mux
	handler = a.guard.Middleware(handler)
	s.srv = &http.Server{
		Addr:         net.JoinHostPort(lc.IP, strconv.FormatUint(uint64(lc.Port), 10)),
		Handler:      handler,
		ReadTimeout:  lc.ReadTimeout,
		WriteTimeout: lc.WriteTimeout,
		IdleTimeout:  lc.IdleTimeout,
	}
	return s, nil
}

