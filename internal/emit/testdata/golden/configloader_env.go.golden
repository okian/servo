//go:build !servoinject

// Code generated by servo generate. DO NOT EDIT.
//
// ServoConfig fills settings from the process environment.
// Settings:
//
//	APP_DSN           string, required
//	APP_MAX_CONNS     int32, default 10
//	APP_CONN_LIFETIME time.Duration, default 30m
//	APP_VERBOSE       bool
//	APP_TOKEN         string, required, secret
//	APP_RATE          float64, default 1.5
//	APP_RETRIES       uint8, default 3
//	APP_BURST         int64, secret
package app

import (
	"errors"
	"fmt"
	"os"
	"strconv"
	"strings"
	"time"
)

// ServoConfig builds settings. Precedence per setting: default, then the APP_* environment
// variable — the environment always wins.
func ServoConfig() (settings, error) {
	var cfg settings
	var missing []string

	// dsn — APP_DSN (required)
	if v, ok := os.LookupEnv("APP_DSN"); ok {
		cfg.dsn = v
	} else {
		missing = append(missing, "APP_DSN")
	}

	// max_conns — APP_MAX_CONNS
	cfg.maxConns = 10
	if v, ok := os.LookupEnv("APP_MAX_CONNS"); ok {
		val, err := strconv.ParseInt(v, 10, 32)
		if err != nil {
			return settings{}, fmt.Errorf("APP_MAX_CONNS: not a valid int32: %q", v)
		}
		cfg.maxConns = int32(val)
	}

	// conn_lifetime — APP_CONN_LIFETIME
	cfg.connLifetime = 30 * time.Minute
	if v, ok := os.LookupEnv("APP_CONN_LIFETIME"); ok {
		val, err := time.ParseDuration(v)
		if err != nil {
			return settings{}, fmt.Errorf("APP_CONN_LIFETIME: not a valid time.Duration: %q", v)
		}
		cfg.connLifetime = val
	}

	// verbose — APP_VERBOSE
	if v, ok := os.LookupEnv("APP_VERBOSE"); ok {
		val, err := strconv.ParseBool(v)
		if err != nil {
			return settings{}, fmt.Errorf("APP_VERBOSE: not a valid bool: %q", v)
		}
		cfg.verbose = val
	}

	// token — APP_TOKEN (required)
	if v, ok := os.LookupEnv("APP_TOKEN"); ok {
		cfg.token = v
	} else {
		missing = append(missing, "APP_TOKEN")
	}

	// rate — APP_RATE
	cfg.rate = 1.5
	if v, ok := os.LookupEnv("APP_RATE"); ok {
		val, err := strconv.ParseFloat(v, 64)
		if err != nil {
			return settings{}, fmt.Errorf("APP_RATE: not a valid float64: %q", v)
		}
		cfg.rate = val
	}

	// retries — APP_RETRIES
	cfg.retries = 3
	if v, ok := os.LookupEnv("APP_RETRIES"); ok {
		val, err := strconv.ParseUint(v, 10, 8)
		if err != nil {
			return settings{}, fmt.Errorf("APP_RETRIES: not a valid uint8: %q", v)
		}
		cfg.retries = uint8(val)
	}

	// burst — APP_BURST
	if v, ok := os.LookupEnv("APP_BURST"); ok {
		val, err := strconv.ParseInt(v, 10, 64)
		if err != nil {
			return settings{}, errors.New("APP_BURST: not a valid int64 (value redacted: secret)")
		}
		cfg.burst = val
	}

	if len(missing) > 0 {
		return settings{}, fmt.Errorf("app: missing required configuration: %s", strings.Join(missing, ", "))
	}
	return cfg, nil
}
